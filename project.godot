; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sims"
run/main_scene="res://Escenas/Menu/Menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://Imagenes/Marca/logo_play_store_512.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.953, 0.961, 0.973, 1)

[autoload]

Variables_Dinamicas="*res://Scripts/Globales/Principales_Variables/Variables_Dinamicas.gd"
Variables_Estaticas="*res://Scripts/Globales/Principales_Variables/Variables_Estaticas.gd"
Sistema_Bolsa="*res://Scripts/Logica/Escena_Principal/Economia/Sistema_Bolsa.gd"
Guardar_Variables_Dinamicas="*res://Scripts/Otro/Guardar/Guardar_Variables_Dinamicas.gd"
Guardar_Variables_Estaticas="*res://Scripts/Otro/Guardar/Guardar_Variables_Estaticas.gd"
Funciones_Globales="*res://Scripts/Globales/Funciones_Globales.gd"
Trabajo="*res://Scripts/Logica/Escena_Principal/Actividades/Trabajo/Trabajo.gd"
Actividades_Habilidades="*res://Scripts/Logica/Escena_Principal/Actividades/Actividades_Habilidades.gd"
Actividades_Necesidades_Basicas="*res://Scripts/Logica/Escena_Principal/Actividades/Actividades_Necesidades_Basicas.gd"
Sistema_Examenes="*res://Scripts/Logica/Escena_Principal/Actividades/Carreras/Sistema_Examenes.gd"
Sistema_Carreras_Deportivas="*res://Scripts/Logica/Escena_Principal/Actividades/Sistema_Carreras_Deportivas.gd"
Sistema_Notificaciones="*res://Scripts/Globales/Sistema_Notificaciones.gd"
Actividades="*res://Scripts/Logica/Escena_Principal/Actividades/Actividades.gd"
Sistema_Futbol="*res://Scripts/Logica/Escena_Principal/Actividades/Futbol/Sistema_Futbol.gd"
Sistema_Manager="*res://Scripts/Logica/Escena_Principal/Manager/Sistema_Manager.gd"
Alimentacion="*res://Scripts/Logica/Escena_Principal/Actividades/Alimentacion.gd"
Sistema_Cocina="*res://Scripts/Logica/Escena_Principal/Minijuego_Cocina/Sistema_Cocina.gd"
Sistema_Granja="*res://Scripts/Logica/Escena_Principal/Granja/Sistema_Granja.gd"
Sistema_Correr="*res://Scripts/Logica/Escena_Principal/Minijuego_Correr/Sistema_Correr.gd"
Eventos_Aleatorios="*res://Scripts/Logica/Escena_Principal/Actividades/Eventos_Aleatorios.gd"
Gestionar_Visibilidad="*res://Scripts/GUI/Escena_Principal/Gestionar_Visibilidad.gd"
Debug_Cargar_Guardado="*res://Scripts/Otro/Debug/Debug_Cargar_Guardado.gd"
Ajustes="*res://Scripts/Globales/Ajustes.gd"
Recompensas="*res://Scripts/Globales/Recompensas.gd"
Musica="*res://Scripts/Globales/Musica.gd"
Pantalla_Carga="*res://Scripts/Globales/Pantalla_Carga.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://UI/Tema_Principal.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

; Juego 2D con UI: el renderer Compatibility es el más rápido y compatible en
; móviles modestos (evita compilación de pipelines Vulkan y drivers problemáticos).
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
