static func Registrar_En(catalogo: Dictionary) -> void:
	for datos in DATOS:
		var clave := str(datos.get("clave", ""))
		if clave == "":
			continue
		var ropa := Objeto_Ropa.new()
		ropa.nombre = clave
		ropa.precio = float(datos.get("precio", 0.0))
		ropa.multiplicador = 1.0
		ropa.afecta_a = "Ropa"
		ropa.es_basico = bool(datos.get("es_basico", false))
		ropa.desbloqueo = str(datos.get("desbloqueo", "inicio"))
		ropa.categoria = str(datos.get("categoria", "diario"))
		ropa.estilo_visual = str(datos.get("estilo_visual", "base"))
		ropa.prenda_superior = str(datos.get("prenda_superior", ""))
		ropa.prenda_inferior = str(datos.get("prenda_inferior", ""))
		ropa.calzado = str(datos.get("calzado", ""))
		ropa.detalle_visual = str(datos.get("detalle_visual", ""))
		ropa.color_principal = str(datos.get("color_principal", ""))
		ropa.color_secundario = str(datos.get("color_secundario", ""))
		ropa.color_detalle = str(datos.get("color_detalle", ""))
		ropa.color_pantalon = str(datos.get("color_pantalon", ""))
		ropa.color_zapatillas = str(datos.get("color_zapatillas", ""))
		ropa.bonus_salario_general = float(datos.get("bonus_salario_general", 0.0))
		ropa.bonus_salario_hosteleria = float(datos.get("bonus_salario_hosteleria", 0.0))
		ropa.bonus_progreso_deporte = float(datos.get("bonus_progreso_deporte", 0.0))
		ropa.bonus_progreso_academico = float(datos.get("bonus_progreso_academico", 0.0))
		ropa.bonus_progreso_manualidades = float(datos.get("bonus_progreso_manualidades", 0.0))
		ropa.reduccion_higiene_trabajo = float(datos.get("reduccion_higiene_trabajo", 0.0))
		ropa.reduccion_higiene_cualquier_trabajo = float(
			datos.get("reduccion_higiene_cualquier_trabajo", 0.0))
		ropa.bonus_propinas_minijuego = float(datos.get("bonus_propinas_minijuego", 0.0))
		ropa.descripcion_efecto = str(datos.get("descripcion_efecto", ""))
		catalogo[clave] = ropa
